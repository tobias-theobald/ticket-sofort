{
  "name": "ticket-sofort",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios:production": "eas build --profile production --platform ios --local",
    "build:android:production": "eas build --profile production --platform android --local",
    "build:ios:preview": "eas build --profile preview --platform ios --local",
    "build:android:preview": "eas build --profile preview --platform android --local",
    "build:ios:development": "eas build --profile development --platform ios --local",
    "build:android:development": "eas build --profile development --platform android --local",
    "test": "jest --watchAll",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "codegen:typesafe-i18n": "typesafe-i18n --no-watch",
    "script:extractor": "bun run scripts/extractInfoFromApkFile.ts"
  },
  "author": "Tobias Theobald <tobitheo@gmail.com>",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@dev-plugins/react-query": "^0.3.1",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.85.3",
    "expo": "^53.0.0",
    "expo-brightness": "~13.1.4",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-router": "~5.1.4",
    "expo-screen-orientation": "~8.1.7",
    "expo-sensors": "~14.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.10",
    "intl-pluralrules": "^2.0.1",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-webview": "13.13.5",
    "typesafe-i18n": "^5.26.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@resolution/eslint-config": "^5.0.0",
    "@resolution/prettier-config": "^1.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.3.0",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.33.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.9",
    "node-apk": "^1.2.1",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.1.1",
    "typescript": "~5.8.3"
  },
  "prettier": "@resolution/prettier-config",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
